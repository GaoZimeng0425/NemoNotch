    "keepawake.restoreFailed.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac is still set to stay awake with the lid closed, and that setting survives a restart. Run “sudo pmset -a disablesleep 0” in Terminal to undo it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 仍处于「合盖不休眠」状态，且该设置重启后依然有效。请在终端执行 “sudo pmset -a disablesleep 0” 还原。"
          }
        }
      }
    },
