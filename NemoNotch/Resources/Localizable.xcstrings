    "settings.keepawake.about.persistent" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That setting is global and survives a restart. If NemoNotch is force-quit before restoring it, run this in Terminal:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该设置是全局的，重启后依然有效。若 NemoNotch 被强制退出而来不及还原，可在终端执行："
          }
        }
      }
    },
    "settings.keepawake.about.privilege" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closing the lid triggers sleep inside the kernel, which ignores the usual sleep-prevention APIs. The only way to stop it is a global system power setting, so each toggle needs one administrator authorization."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合盖休眠由内核处理，会忽略常规的防休眠接口。唯一能挡住它的是一项全局系统电源设置，因此每次切换都需要一次管理员授权。"
          }
        }
      }
    },
    "settings.keepawake.aboutHeader" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How this works"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作原理"
          }
        }
      }
    },
    "settings.keepawake.copyCommand" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复制"
          }
        }
      }
    },
    "settings.keepawake.enable" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevent sleep when the lid closes"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合盖时不休眠"
          }
        }
      }
    },
    "settings.keepawake.lidDisplayOff" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off the display when the lid closes"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合盖时自动熄屏"
          }
        }
      }
    },
    "settings.keepawake.lidDisplayOff.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With sleep disabled the screen stays lit behind a closed lid, which keeps draining the battery and building up heat. Skipped when an external display is connected — that is the clamshell setup you probably want."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "禁用休眠后，合盖时屏幕不会自动熄灭，会持续耗电发热。接有外接显示器时不熄屏 —— 那正是常见的合盖外接工作方式。"
          }
        }
      }
    },
    "settings.keepawake.optionsHeader" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Options"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选项"
          }
        }
      }
    },
    "settings.keepawake.restoreOnQuit" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restore normal sleep when quitting"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出时还原休眠设置"
          }
        }
      }
    },
    "settings.keepawake.restoreOnQuit.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitting NemoNotch turns sleep prevention back off, which needs one more authorization prompt. Leave this off to keep the setting after quitting — you will have to turn it off yourself."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出 NemoNotch 时自动关闭防休眠，会再弹一次授权框。关掉此项则退出后设置继续保留 —— 需要你自己记得关。"
          }
        }
      }
    },
    "settings.keepawake.status.authorizing" : {
      "localizations" : {
